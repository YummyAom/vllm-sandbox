# Hugging Face Access Token (Required for gated models like Llama-3, Gemma-2)
HF_TOKEN=

# Model identifier from Hugging Face or local path
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Custom alias for the model endpoint in OpenAI-compatible API
SERVED_MODEL_NAME=qwen2.5

# Host port mapping
PORT=8000

# GPU memory utilization ratio (0.0 to 1.0)
GPU_MEMORY_UTILIZATION=0.85

# Maximum model context length (reduce if encountering KV Cache OOM)
MAX_MODEL_LEN=4096

# Optional API Key for securing the vLLM server
VLLM_API_KEY=
